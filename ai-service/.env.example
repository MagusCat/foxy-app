# Copia a .env y rellena las obligatorias. .env NO se versiona.
#
# El proceso valida esto al arrancar y se niega a levantar si algo falta o es
# inválido, listando todos los problemas de una vez. Una obligatoria vacía cuenta
# como ausente. El resto de perillas (timeouts, techos, chunking) tiene default y
# está en ../docs/configuration.md.

# Usa el Session Pooler (IPv4); la conexión directa es solo IPv6.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=

# La misma clave que el backend, byte a byte. Omitible solo con ALLOW_INSECURE=true.
AI_SERVICE_TOKEN=

# fake = responde sin red ni llave (desarrollo). openai_compat = un endpoint real.
LLM_PROVIDER=openai_compat

# ── Obligatorias con LLM_PROVIDER=openai_compat (no hay presets) ───────────────
# El endpoint y los modelos van explícitos: gemini, deepseek, openai, groq,
# openrouter, vLLM u ollama, cada uno con su URL y su modelo.
LLM_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=
# Opcional: los endpoints locales (ollama, vLLM) no piden llave.
LLM_API_KEY=
# Solo si los embeddings van a otro endpoint que el chat (p. ej. deepseek + gemini).
# Vacías = usan el LLM_BASE_URL / LLM_API_KEY de arriba.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ── Desarrollo ────────────────────────────────────────────────────────────────
# ALLOW_INSECURE=true    arranca sin AI_SERVICE_TOKEN y monta /docs. Nunca en producción.
# LLM_PROVIDER=fake       ignora todo lo de LLM_* de arriba.
