# Copia a .env y rellena estas cuatro. .env NO se versiona.
#
# Aquí solo están las obligatorias. Todo lo opcional (bind, CORS, rate limit,
# timeouts, pool) tiene default y está documentado —con su valor por defecto y su
# porqué— en ../docs/configuration.md. Ponlo en tu .env solo cuando lo cambies.
#
# El backend NO lee .env por sí solo (solo os.Getenv); hay que exportarlo antes:
#   set -a && . ./.env && set +a && go run ./cmd/api
#
# config.Load() valida esto al arrancar y se niega a levantar si algo falta o está
# mal escrito, listando todos los problemas de una vez. Una obligatoria puesta
# pero vacía cuenta como ausente.
#
# Para desarrollo local sin el ai-service: AI_SERVICE_URL=stub (respuestas fijas
# sin red) y ALLOW_INSECURE=true (arranca sin AI_SERVICE_TOKEN). Ver el doc.

# Usa el Session Pooler (IPv4); la conexión directa es solo IPv6.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
# La secret key del panel. Se sigue aceptando el nombre viejo SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# La misma clave que el ai-service. Omitible con AI_SERVICE_URL=stub o ALLOW_INSECURE=true.
AI_SERVICE_TOKEN=
