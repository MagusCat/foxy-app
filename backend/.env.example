# Copia este archivo a .env y completa los valores. .env NO se versiona.

PORT=8080
LOG_LEVEL=debug

# Postgres de Supabase — usa el SESSION POOLER (IPv4). La conexión directa es
# solo IPv6 y suele fallar con ECONNREFUSED.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Proyecto Supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # secreta: nunca sale del backend ni llega al móvil
STORAGE_BUCKET=attachments

# El JWKS y el issuer se derivan de SUPABASE_URL; descoméntalos solo para sobreescribir.
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1

# ai-service. "stub" = respuestas fijas locales, sin red (para desarrollar sin Python).
AI_SERVICE_URL=stub

# ── Opcionales (tienen default; descoméntalas solo para cambiarlas) ────────────

# CORS. En producción FÍJALO a los orígenes reales de la app; no dejes "*".
# ALLOWED_ORIGINS=https://app.foxy.com,https://admin.foxy.com

# Rate limit de los endpoints que cuestan IA (por usuario, en memoria).
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_BURST=10

# Timeouts. REQUEST_TIMEOUT no aplica al streaming SSE (es largo a propósito).
# REQUEST_TIMEOUT=30s
# SHUTDOWN_TIMEOUT=10s

# Tamaño del pool de conexiones a Postgres.
# DB_MAX_CONNS=10

# Persona base de Foxy. Por defecto se cargan los prompts de internal/feature/chat/prompts/;
# esta variable sobreescribe el prompt base sin tocar código.
# FOXY_SYSTEM_PROMPT=
